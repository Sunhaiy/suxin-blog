# ============================================================
# 数据库 (PostgreSQL)
# ============================================================
DATABASE_URL="postgresql://user:password@localhost:5432/lihuahaimax"
# 或拆分写法（pg 连接池优先使用 DATABASE_URL，若无则读取以下字段）
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="lihuahaimax"
PGUSER="your_db_user"
PGPASSWORD="your_db_password"

# ============================================================
# NextAuth.js (Auth.js v5)
# ============================================================
# 在生产环境替换为真实随机字符串，例如：openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-replace-in-production"
AUTH_URL="http://localhost:3000"
# 管理员账号（首次可用环境变量兜底，后台保存后会写入数据库）
ADMIN_EMAIL="admin@lihuahai.com"
ADMIN_PASSWORD="your-secure-admin-password"

# ============================================================
# 应用基础 URL
# ============================================================
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ============================================================
# SEO automatic submission
# ============================================================
# Search Console / Webmaster Tools verification tags
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
BAIDU_SITE_VERIFICATION=""
# Microsoft Clarity project ID. Leave blank to disable Clarity.
MICROSOFT_CLARITY_ID=""
# Set to "false" to disable all automatic search engine submission hooks.
SEARCH_SUBMIT_ENABLED="true"
# IndexNow key. Leave blank to disable IndexNow submission.
INDEXNOW_KEY=""
# Optional override. Defaults to https://api.indexnow.org/indexnow
INDEXNOW_ENDPOINT="https://api.indexnow.org/indexnow"
# Optional override. Defaults to {site-origin}/indexnow-key.txt
INDEXNOW_KEY_LOCATION=""
# Baidu normal inclusion API token. Leave blank to disable Baidu submission.
BAIDU_TOKEN=""
# Usually the verified host in Baidu Search Resource Platform, for example www.example.com
BAIDU_SITE=""
# Optional override. The historical official example uses http://data.zz.baidu.com/urls
BAIDU_SUBMIT_ENDPOINT="http://data.zz.baidu.com/urls"
# Optional. Example: original
BAIDU_SUBMIT_TYPE=""

# ============================================================
# 媒体文件存储
# ============================================================
# 上传文件保存到服务器本地的绝对路径
UPLOAD_DIR="./public/uploads"
# 对外访问时的 URL 前缀
UPLOAD_PUBLIC_PATH="/uploads"

# ============================================================
# API Key 鉴权（私人桌面软件访问博客 API）
# ============================================================
# 生成方法：openssl rand -hex 32
# 使用方法：请求头加 Authorization: Bearer <此处填入的值>
# 留空则禁用 API Key 鉴权（仅允许浏览器 Session）
ADMIN_API_KEY=""

# ============================================================
# DeepSeek 自动写文
# ============================================================
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# ============================================================
# 定时任务 (Cron)
# ============================================================
# 小米手环数据接入预留（未来对接第三方 API 或本地同步脚本）
MI_BAND_SYNC_CRON="0 * * * *"
MI_BAND_API_TOKEN=""
